SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/auth/spotify/callback
NEXT_PUBLIC_SITE_NAME="Old School Shuffle"
NEXT_PUBLIC_TAGLINE="Playlist-led music writing, after-hours recommendations, and an editorial queue built to be explored like a stream."
